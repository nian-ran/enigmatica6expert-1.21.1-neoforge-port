	quest.000000000000043D.quest_desc: ["所有必需的维生素,矿物质和氨基酸, 整齐地凝结成一个方便的咀嚼糊."]
	quest.000000000000043D.quest_subtitle: "黄绿色"
	quest.0000000000000449.quest_desc: [""]
	quest.0000000000000449.quest_subtitle: "进步的代价"
	quest.000000000000044F.quest_desc: ["一个基本的多工具,在静脉采矿中建造 和出色的攻击破坏。"]
	quest.000000000000044F.quest_subtitle: "别离开那个Plasma Cutter跑道"
	quest.0000000000000451.quest_desc: [
