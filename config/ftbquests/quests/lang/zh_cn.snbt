	quest.00000000000001D5.quest_subtitle: "现在是时候踢你的..."
	quest.00000000000001D7.quest_desc: ["每件装甲件最多可接受四件,用于极端保护."]
	quest.00000000000001D7.quest_subtitle: "你试过要坚强 但你的盔甲不够坚强"
	quest.00000000000001D7.title: "护甲升级"
	quest.00000000000001E7.quest_desc: ["这个手提装置能帮你保持你宝贵的经验"]
	quest.00000000000001E7.quest_subtitle: "分享经验"
	quest.00000000000001ED.quest_desc: [""]
	quest.00000000000001ED.title: "跳跃式升级"
	quest.00000000000001F5.quest_desc: [""]
	quest.00000000000001F5.title: "Jet靴子升级"
	quest.00000000000001F7.quest_desc: [
		"蝙蝠,他们中最大的敌人 现在,他们的末日在你手里"
		""
		"微型导弹是寻找炸药的目标,不会破坏地形,可以配置不同程度的爆炸破坏、行驶速度和转弯速度。右键点击以配置。"
	]
	quest.00000000000001F7.quest_subtitle: "目标获得"
	quest.00000000000001F9.quest_desc: ["智能炮塔可以过滤到只攻击某些生物。例如,只有成年动物。"]
	quest.00000000000001F9.quest_subtitle: "站立并交付"
	quest.00000000000001FB.quest_desc: ["现代的怪物杀人法 也不错"]
	quest.00000000000001FB.quest_subtitle: "播放字段的级别"
	quest.0000000000000202.quest_desc: ["加工一些专门的弹药,并给他们一个尝试,常规的弹药也可以涂上一种药剂,以给予它一点额外的乌姆."]
	quest.0000000000000202.quest_subtitle: "每一次的场合"
	quest.0000000000000202.title: "弹药"
	quest.000000000000020E.quest_desc: [
		"爬虫入侵把你弄下来了?"
